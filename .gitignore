# Ignore node modules and build artifacts
node_modules/
.svelte-kit/

# Ignore environment files
.env*

# Ignore log and temp files
log/
tmp/
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory
tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases)
storage/*
!/storage/.keep
tmp/storage/*
!/tmp/storage/.keep

# Ignore default key files and credentials
config/master.key
config/credentials/*.key

# Ignore Docker and CI files
.dockerignore
Dockerfile*
.github/

# Ignore Kamal deployment files
.kamal/
config/deploy*.yml

# Ignore bundler config
.bundle/

# Ignore devcontainer
.devcontainer/

# Ignore frontend environment
frontend/.env

# Ignore backend environment
backend/.env*

# Ignore system files
.DS_Store
Thumbs.db 